# Placeholder-only example values. Do not copy production secrets into this file.
# Set LOCAL_SERVICES=yes, LOCAL_DB=yes, LOCAL_DESTRUCTIVE=yes, or LOCAL_LEGAL_DATA_OPS=yes only for explicit local operations.

# Meta-Harness MADFAM integration - environment template
# Copy to .env and fill in. DO NOT commit .env.

# --- Inference backend (one of these required) -----------------------------
# Preferred: Selva centralized inference proxy (OpenAI-compat /v1).
# See memory/project_inference_centralization.md.
SELVA_API_BASE=change-me-placeholder
SELVA_API_KEY=change-me-placeholder

# Bridge: DeepInfra direct (while Anthropic is paused or Selva's DeepInfra
# secret isn't yet deployed). See
# selva-office/docs/runbooks/BRIDGE_DEEPINFRA.md.
DEEPINFRA_API_KEY=change-me-placeholder
# Optional override; defaults to https://api.deepinfra.com/v1/openai
# DEEPINFRA_API_BASE=

# Explicit override. Values: selva | deepinfra. Leave unset to auto-pick
# (prefers selva if both SELVA_* are set, else falls back to deepinfra).
# MADFAM_INFERENCE_PROVIDER=

# Experiment identity, used for Selva usage metering + audit log
MADFAM_EXPERIMENT_ID=tezca-spike
MADFAM_EXPERIMENT_OWNER=

# --- Budget gate (required) -------------------------------------------------
# Absolute hard cap in USD. The gate will refuse to start a run whose estimated
# worst-case cost exceeds this. Per-run approval is still required.
MADFAM_BUDGET_HARD_CAP_USD=10.00

# Grace factor applied to approved budget before mid-run kill. 1.10 = 10% grace.
MADFAM_BUDGET_GRACE_FACTOR=1.10

# Where to persist approval records. Append-only.
MADFAM_APPROVALS_DIR=./approvals
MADFAM_LOGS_DIR=./logs

# --- Proposer (optional) ----------------------------------------------------
# Meta-Harness uses a proposer agent (default: Claude Code) that writes
# candidate harness code. Routed through Selva so metering captures it.
# Leave unset to fall back to the shipped claude_wrapper behavior.
MADFAM_PROPOSER_MODEL=claude-opus-4-7
LOCAL_SERVICES=no
LOCAL_DB=no
LOCAL_DESTRUCTIVE=no
LOCAL_LEGAL_DATA_OPS=no
