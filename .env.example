# Placeholder-only example values. Do not copy production secrets into this file.
# Set LOCAL_SERVICES=yes, LOCAL_DB=yes, LOCAL_DESTRUCTIVE=yes, or LOCAL_LEGAL_DATA_OPS=yes only for explicit local operations.

# ── Django ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-placeholder
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Deployment mode: "managed" (Tezca-hosted) or "self-hosted".
# Self-hosted instances have their effective tier capped at academic.
TEZCA_DEPLOYMENT=managed

# Comma-separated Janua user IDs allowed admin access (in addition to JWT
# `role: admin` claims). Leave empty to require role-based access only.
TEZCA_ADMIN_USER_IDS=

# ── Database ──────────────────────────────────────────────────────────
# Default: SQLite (no config needed). Set DB_ENGINE for PostgreSQL:
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.postgresql
DB_NAME=leyes_mx
DB_USER=leyes_mx
DB_PASSWORD=change-me-placeholder
DB_HOST=localhost
DB_PORT=5432

# Postgres connection knobs tuned for the CNPG cluster (per Track 6 of
# docs/strategy/FEATURE_PARITY_PLAN_2026-04-27.md §3.2). Defaults are
# safe for both single-instance and CNPG topologies.
# DB_CONNECT_TIMEOUT=5         # seconds; fail-fast on dead primary
# DB_KEEPALIVES_IDLE=30        # seconds; detect dropped conns < 60s
# DB_CONN_MAX_AGE=0            # 0 = open/close per request (PgBouncer fronts)

# ── Elasticsearch ─────────────────────────────────────────────────────
ES_HOST=http://localhost:9200
# Required when xpack.security.enabled=true (default in docker-compose.yml).
# Override the dev-only password before exposing the stack to anything that
# isn't your laptop.
ES_USERNAME=elastic
ES_PASSWORD=change-me-placeholder

# ── Celery / Redis ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Next.js (Web + Admin) ────────────────────────────────────────────
# Browser-facing API URL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side API URL for SSR inside Docker (Next.js → Django via the
# compose network). Falls back to NEXT_PUBLIC_API_URL when unset, which
# breaks SSR in Docker since localhost won't resolve to the api container.
INTERNAL_API_URL=http://api:8000/api/v1

# Master switch between InterestGate (interest-capture) and TierGate
# (full checkout). Default false — flip to true only after Tulana PMF
# composite score crosses the activation threshold (see RFC 0013).
NEXT_PUBLIC_MONETIZATION_ENABLED=false

# ── Janua Auth (web + admin) ──────────────────────────────────────────
# Backend JWT validation
JANUA_ISSUER_URL=https://janua.example.invalid
JANUA_AUDIENCE=placeholder-value
# Next.js SDK (shared by web + admin)
NEXT_PUBLIC_JANUA_ISSUER_URL=https://auth.madfam.io
# Run: cd <janua>/apps/api && python scripts/seed_core_clients.py
NEXT_PUBLIC_JANUA_PUBLISHABLE_KEY=placeholder-value
JANUA_SECRET_KEY=change-me-placeholder

# ── Document Storage ──────────────────────────────────────────────────
# Backend: "local" (default, zero config) or "r2" (Cloudflare R2 for production)
# STORAGE_BACKEND=r2

# Cloudflare R2 (S3-compatible) — only needed when STORAGE_BACKEND=r2
# Same CF account as Enclii (PG backups, SBOMs, artifacts)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=tezca-documents
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# ── Quality Quarantine ────────────────────────────────────────────────
# Comma-separated quality grades (A-F) to quarantine from indexing. Leave
# default unless tuning the parser pipeline.
QUALITY_QUARANTINE_GRADES=D,F

# ── First-party AI assistant (/preguntar) ─────────────────────────────
# Master kill-switch for the chat endpoint. Defaults to false so the
# scaffold can ship without the route being live. Flip to "true" once
# Selva onboarding (cross-cutting Track 8) lands.
CHAT_ENABLED=false
# Selva client backend selection. "mock" returns deterministic canned
# responses (default; safe for dev + tests). "selva" forwards to the
# OpenAI-compatible /v1/chat/completions endpoint declared below.
CHAT_BACKEND=mock
# Required when CHAT_BACKEND=selva. The canonical public Selva domain
# is `selva.town` (per RFC 0010 Layer 2).
SELVA_API_URL=https://inference.selva.town/v1
# Janua-relayed bearer token for the tezca service account on Selva.
# Provisioned via the Selva onboarding ticket; rotate per the standard
# Janua client-credentials flow.
SELVA_API_TOKEN=change-me-placeholder
# Default model for chat completions. Cheapest model that fits the
# typical RAG context window.
SELVA_DEFAULT_MODEL=change-me-placeholder

# ── Billing (Dhanam) ──────────────────────────────────────────────────
# Checkout URL the frontend redirects users to for tier purchases.
DHANAM_CHECKOUT_URL=https://checkout.example.invalid/tezca
# HMAC-SHA256 secret signing /api/v1/billing/webhook/. Required in any
# environment where Dhanam delivers subscription events.
DHANAM_WEBHOOK_SECRET=change-me-placeholder
# Frontend-visible Dhanam API base. Used by /cuenta/billing to fetch the
# customer-portal URL and the invoice list. Override only in
# dev/staging when pointing at a non-prod Dhanam instance.
NEXT_PUBLIC_DHANAM_API_URL=https://api.dhan.am

# Trial durations (days). NO_CC = before user supplies a card; WITH_CC =
# extended duration once Dhanam fires trial.cc_provided.
TRIAL_DURATION_NO_CC_DAYS=3
TRIAL_DURATION_WITH_CC_DAYS=21

# ── Madfam Crawler (scraping-as-a-service) ────────────────────────────
# Crawl endpoint of the shared madfam-crawler service. MadfamBridge
# (apps/scraper/client/madfam_bridge.py) delegates hostile detail-page
# extraction here. Defaults to the in-cluster FQDN
# (service "crawler-api", namespace "madfam-crawler"); override for
# local/dev setups.
# MADFAM_CRAWLER_URL=http://crawler-api.madfam-crawler.svc.cluster.local:8000/v1/crawl
# API key for the crawler's ApiKeyMiddleware. When set, MadfamBridge sends
# it as "X-Api-Key" on every crawler request (dispatch POST + status-poll
# GETs); when unset, the header is omitted (local/dev crawlers without
# auth). In production this is wired from the tezca-secrets key
# MADFAM_CRAWLER_TOKEN (optional: true), minted by the operator and
# mirrored into the crawler's API_KEYS.
# MADFAM_CRAWLER_TOKEN=placeholder-crawler-token

# ── CRM (Phynd-CRM) ───────────────────────────────────────────────────
# Webhook receiver for interest.created / newsletter.subscribed events.
# When unset, crm_sync.py no-ops cleanly.
CRM_WEBHOOK_URL=https://example.invalid/webhook
CRM_WEBHOOK_SECRET=change-me-placeholder

# ── Analytics (PostHog) ───────────────────────────────────────────────
# Backend tracking. No-op when unset.
POSTHOG_API_KEY=placeholder-dsn
POSTHOG_HOST=placeholder-dsn
# Frontend tracking ($pageview + 35 conversion events). No-op when unset.
NEXT_PUBLIC_POSTHOG_KEY=placeholder-dsn
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry Error Tracking ────────────────────────────────────────────
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── PMF Widget (RFC 0013) ─────────────────────────────────────────────
# Per RFC 0013, Tezca embeds @madfam/pmf-widget which posts NPS / Sean
# Ellis / smile signals to Tulana's /v1/pmf/* endpoints. Composite PMF
# Score from Tulana gates the MONETIZATION_ENABLED flip.
#
# Default: disabled. Flip to "true" only after:
#   1. @madfam/pmf-widget@^0.1.0 is published to the MADFAM npm registry
#      (currently blocked on NPM_MADFAM_TOKEN rotation, operator-only)
#   2. `npm install @madfam/pmf-widget` succeeds in apps/web
#   3. The local stub at apps/web/types/madfam-pmf-widget.d.ts is removed
NEXT_PUBLIC_PMF_WIDGET_ENABLED=false
# Tulana ingest endpoint base URL. Override in dev/staging if pointing
# at a non-prod Tulana instance.
NEXT_PUBLIC_TULANA_API_URL=https://tulana-api.madfam.io

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
LOCAL_SERVICES=no
LOCAL_DB=no
LOCAL_DESTRUCTIVE=no
LOCAL_LEGAL_DATA_OPS=no
